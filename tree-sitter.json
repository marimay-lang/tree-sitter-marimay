{
  "grammars": [
    {
      "name": "marimay",
      "camelcase": "Marimay",
      "scope": "source.marimay",
      "path": ".",
      "file-types": [
        "my"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^marimay$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Marimay programming language",
    "authors": [
      {
        "name": "Marimay contributors"
      }
    ],
    "links": {
      "repository": "http://gitea.example.invalid:3000/Marimay/tree-sitter-marimay"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
