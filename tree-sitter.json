{
  "grammars": [
    {
      "name": "ruda",
      "camelcase": "Ruda",
      "scope": "source.ruda",
      "path": ".",
      "file-types": [
        "ruda"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^ruda$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the Ruda programming language",
    "authors": [
      {
        "name": "Ruda contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/ruda-lang/tree-sitter-ruda"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
