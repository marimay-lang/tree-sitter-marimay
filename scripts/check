#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

npx tree-sitter generate
mkdir -p build
npx tree-sitter build -o build/marimay.dylib .
npx tree-sitter test --lib-path build/marimay.dylib --lang-name marimay
npx tree-sitter query --quiet \
  --lib-path build/marimay.dylib \
  --lang-name marimay \
  queries/highlights.scm \
  test/fixtures/all-productions.my

status=0
for fixture in test/fixtures/*.my; do
  output=$(npx tree-sitter parse --quiet \
    --lib-path build/marimay.dylib \
    --lang-name marimay \
    "$fixture")
  if [ -z "$output" ]; then
    printf 'parse: ok: %s\n' "$fixture"
  else
    printf '%s\n' "$output" >&2
    status=1
  fi
done

for fixture in test/invalid/*.my; do
  output=$(npx tree-sitter parse --quiet \
    --lib-path build/marimay.dylib \
    --lang-name marimay \
    "$fixture" 2>/dev/null || true)
  if [ -n "$output" ]; then
    printf 'parse: rejected: %s\n' "$fixture"
  else
    printf 'expected parse error: %s\n' "$fixture" >&2
    status=1
  fi
done

if [ -n "${MMAY:-}" ]; then
  if [ ! -x "$MMAY" ]; then
    printf 'MMAY is not executable: %s\n' "$MMAY" >&2
    status=1
  else
    for fixture in test/fixtures/*.my; do
      if "$MMAY" fmt "$fixture" --check; then
        printf 'mmay fmt: ok: %s\n' "$fixture"
      else
        status=1
      fi
    done
  fi
fi

exit "$status"
